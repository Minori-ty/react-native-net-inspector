# This package is consumed through a `file:` link by the demo app, which owns the
# SDK-matched copies of react-native, expo-clipboard and friends.
#
# npm 7+ installs every peer dependency automatically, and the ranges here are
# open-ended (`>=`), so running `npm install` inside this folder pulls the latest
# react-native / expo-clipboard and creates a second dependency tree that shadows
# the app's. The two copies then disagree at runtime — an Expo module from SDK 58
# initialising inside an SDK 57 app throws `property is not writable` and takes
# the host app down with it.
#
# Install from the repository root instead. This setting only affects installs
# run in this folder; consumers are unaffected.
legacy-peer-deps=true
